<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AImerMain"
        tools:targetApi="31">
        <activity
            android:name=".activity_result"
            android:exported="false" />
        <activity
            android:name=".activity_genre_select"
            android:exported="false" /> <!-- ジャンル選択画面：ここを LAUNCHER に設定 -->
        <activity
            android:name=".GenreSelectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- ゲーム本編：LAUNCHER 属性を削除 -->
        <activity
            android:name=".braintraining"
            android:exported="false" /> <!-- 結果画面：追加 -->
        <activity
            android:name=".ResultActivity"
            android:exported="false" /> <!-- メイン画面（必要であれば残す、不要なら削除） -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>